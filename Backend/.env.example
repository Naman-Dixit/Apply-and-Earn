# Port on which the backend server will run
PORT=5000

# Environment mode: development | production
NODE_ENV=development

# Your MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/referearn?retryWrites=true&w=majority

# Reward coins credited when a referral code is applied
REWARD_COINS=50

# Number of bcrypt salt rounds (recommended: 10)
BCRYPT_SALT_ROUNDS=10
